NODE_ENV=development
PORT=5000

# Supabase PostgreSQL connection string. Keep this backend-only; never put it in Vite env.
DATABASE_URL=
# Verify TLS and the database server certificate/hostname.
DATABASE_SSL=verify-full
# Optional Supabase root CA bundle path when required by your runtime.
DATABASE_SSL_CA=
# Optional direct Supabase URL for migrations. Use direct or session mode, never transaction mode.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=5

# Keep these custom CivicSync authentication secrets stable and private.
JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=

CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1

# Development can use local disk. Hosted deployments should use Cloudinary.
STORAGE_PROVIDER=local
CLOUDINARY_URL=

# Optional
CRON_SECRET=
WEATHER_SIMULATE_MM=
